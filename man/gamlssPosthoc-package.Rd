\name{gamlssPosthoc-package}
\alias{gamlssPosthoc}
\alias{gamlssPosthoc-package}
\docType{package}
\title{Marginal, Distributional, and Graphical Post-Hoc Inference for GAMLSS}
\description{
Tools for post-hoc inference and data-first scientific visualization after generalized additive models for location, scale and shape. The package separates statistical estimands, target populations, comparison scales, uncertainty methods, and graphical rendering while routing supported tasks across emmeans, marginaleffects, and full-distribution prediction engines.
}
\details{
Main functions are \code{gamlss_posthoc()}, \code{gamlss_posthoc_plan()},
\code{gamlss_trend()}, \code{gamlss_distribution_summary()},
\code{gamlss_poly_compare()}, \code{gamlss_cld()}, \code{gamlss_plot_data()}, and the \code{plot_gamlss_*()} visualization family.
}
\references{
Rigby, R. A. and Stasinopoulos, D. M. (2005). Generalized additive models for
location, scale and shape. Journal of the Royal Statistical Society: Series C,
54, 507--554. \doi{10.1111/j.1467-9876.2005.00510.x}
}
